# Neon Postgres connection string. Use the pooled connection string on Vercel.
# Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Comma-separated username:passwordHash entries.
# Create a hash without putting the password in the command history:
# ADMIN_PASSWORD_INPUT='your-password' node scripts/hash-admin-password.mjs username
# Add another administrator by appending ,second-user:scrypt$...
ADMIN_USERS=
